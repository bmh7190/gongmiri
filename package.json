{
  "name": "gongmiri",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:react": "vite --config vite.react.config.ts",
    "typecheck": "npm run typecheck:react && npm run typecheck:node",
    "typecheck:react": "tsc -b tsconfig.react.json",
    "typecheck:node": "tsc -b tsconfig.node.json",
    "build": "npm run typecheck && vite build && npm run verify:extension",
    "build:react": "npm run typecheck && vite build --config vite.react.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:extension": "node scripts/verify-extension.mjs",
    "verify:column-resize": "node scripts/verify-column-resize.mjs",
    "fixture:browser": "node scripts/create-browser-fixture.mjs",
    "benchmark:parser": "node scripts/parse-benchmark.mjs",
    "benchmark:large": "node scripts/parse-benchmark.mjs --scenario=points-100k --quick",
    "benchmark:polygon": "node scripts/parse-benchmark.mjs --scenario=polygons-500k-coords --quick"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^9.2.4",
    "but-unzip": "^0.1.7",
    "geojson-vt": "^4.0.2",
    "i18next": "^25.10.10",
    "maplibre-gl": "^5.12.0",
    "proj4": "^2.19.10",
    "react": "^19.2.8",
    "react-data-grid": "^7.0.0-beta.61",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.6.6",
    "shpjs": "^6.2.0",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@mapbox/shp-write": "^0.4.3",
    "@types/chrome": "^0.1.27",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/shpjs": "^3.4.7",
    "@vitejs/plugin-react": "^5.2.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
